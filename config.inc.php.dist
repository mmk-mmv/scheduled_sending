// Modified by Scheduled Sending contributors, 2026-10-23. GPL-3.0; see LICENSE and CREDITS.md.
// MySQL/MariaDB InnoDB queue; set the same name in both settings if using the legacy alias.
$config['db_table_scheduled_sending'] = 'scheduled_queue';
// Queue page uses browser-local time; preferences/toasts use this display timezone.
$config['scheduled_timezone'] = 'UTC';
$config['scheduled_sending_batch'] = 20;
$config['scheduled_sending_worker_budget'] = 45; // seconds; checked between jobs
$config['scheduled_sending_connect_retries'] = 12; // only before any SMTP submission
$config['scheduled_sending_retry_delay'] = 300;
$config['scheduled_sending_max_message_size'] = 8388608; // complete encoded MIME
$config['scheduled_sending_logging'] = false;
$config['scheduled_debug'] = false; // traces may contain addresses and other message metadata
